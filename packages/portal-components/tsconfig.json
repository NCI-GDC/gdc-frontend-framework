{
  "include": ["src/**/*", "tailwind.config.js"],
  "exclude": ["node_modules", "../../node_modules/type-fest/*"],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/dts",
    "declarationMap": true,
    "declaration": true,
    "jsx": "react",
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "allowJs": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "strict": true,
    "resolveJsonModule": true,
    "target": "es2015",
    "lib": ["dom", "esnext"],
    "baseUrl": ".",
    "paths": {
      "@/layout/*": ["src/layout/*"],
      "@/modals/*": ["src/modals/*"]
    },

    "skipLibCheck": true,
    "types": ["node"]
  }
}

{
  "name": "gdc-frontend-framework",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "version": "2.19.0",
  "description": "The GDC Frontend Framework",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:int": "npm run test:int --workspaces --if-present",
    "test:all": "npm run test:all --workspaces --if-present",
    "compile": "lerna run compile",
    "dev": "lerna run dev",
    "dev:gdc": "lerna run dev --scope portal-proto",
    "dev:enclave": "lerna run dev --scope enclave-portal",
    "prepare": "husky",
    "build": "lerna run build",
    "build:clean": "lerna run build:clean",
    "build:components": "lerna run build:clean --scope @gff/portal-components",
    "start": "lerna run start",
    "build-docs": "typedoc",
    "version": "npm version --workspaces --git-tag-version=false",
    "mocks": "mocks-server"
  },
  "lint-staged": {
    "!(**/*.png)": [
      "prettier --write --ignore-unknown",
      "pre-commit run --files"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NCI-GDC/gdc-frontend-framework.git"
  },
  "author": "",
  "license": "Apache-2.0",
  "homepage": "https://github.com/NCI-GDC/gdc-frontend-framework#readme",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "dom-to-svg": "^0.12.2",
    "echarts": "^5.5.1",
    "file-saver": "^2.0.5",
    "isomorphic-fetch": "^3.0.0",
    "lodash": "^4.17.23",
    "react": "^19.2.3",
    "react-cookie": "^7.2.2",
    "react-dom": "^19.2.3",
    "react-use": "^17.3.2",
    "sharp": "^0.34.1",
    "url-join": "^5.0.0",
    "use-deep-compare": "^1.3.0"
  },
  "devDependencies": {
    "@mocks-server/main": "^4.1.0",
    "@next/eslint-plugin-next": "^12.1.5",
    "@svgr/webpack": "^8.0.1",
    "@swc/core": "^1.15.21",
    "@types/file-saver": "^2.0.5",
    "@types/isomorphic-fetch": "^0.0.35",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.14.178",
    "@types/plotly.js": "^1.54.14",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@types/react-table": "^7.7.12",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.24.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-tsdoc": "^0.2.17",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-slow-test-reporter": "^1.0.0",
    "lerna": "^9.0.7",
    "lint-staged": "^12.3.7",
    "nx": "^22.6.4",
    "prettier": "^3.8.1",
    "ts-jest": "^29.2.5",
    "typedoc": "^0.25.4",
    "typedoc-plugin-missing-exports": "^2.1.0"
  },
  "overrides": {
    "glob": "^11.0.0",
    "globby": "^11.0.4",
    "@napi-rs/magic-string": "0.3.4"
  },
  "engines": {
    "node": "^24.14.0",
    "npm": "^11.11.0"
  }
}

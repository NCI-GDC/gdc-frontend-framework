{
  "targetDefaults": {
    "compile": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "build:clean": {
      "dependsOn": ["^build:clean"]
    },
    "build": {
      "dependsOn": ["compile", "^build"],
      "cache": true,
      "outputs": ["{projectRoot}/dist", "{projectRoot}/.next"]
    },
    "build:sm": {
      "dependsOn": ["compile", "^build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "continuous": true
    },
    "dev-https": {
      "dependsOn": ["^build"],
      "cache": false,
      "continuous": true
    }
  },
  "analytics": false
}
